# Copy to .env (gitignored) and replace every placeholder.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopflow
DB_USER=shopflow
DB_PASSWORD=CHANGE_ME_local_password

# Must be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random_value

# Optional. When both are set, the first admin user is created at boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=
